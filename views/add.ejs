<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/root.css" />
    <link rel="stylesheet" href="/styles/search.css" />
    <link rel="stylesheet" href="/styles/cardResults.css" />
    <title>Add Inventory</title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <section>
      <h1>Add New Inventory</h1>
      <form method="GET" class="search-bar">
        <button type="submit" aria-label="Search for card data">
          <img src="/images/search.svg" alt="" />
        </button>

        <input
          type="text"
          name="searchName"
          placeholder="Search Card Here..."
          required
        />

        <select id="search-game" name="searchGame" required>
          <option value="" disabled selected></option>
          <option value="lorcana">Lorcana</option>
          <option value="pokemon">Pokemon</option>
          <option value="magic">Magic</option>
        </select>
      </form>
      <%- include("partials/cardDataResults") %>
    </section>
  </body>
</html>
