<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/root.css" />
    <link rel="stylesheet" href="/styles/cardForm.css" />
    <title>Add Iventory Form</title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <h1>Add Card To Inventory</h1>
    <strong class="info-text">
      Lines with <img src="/images/non-edit.svg" class="helper-img" /> cannot be
      changed.
    </strong>

    <section class="card-form">
      <img
        src="<%= card.image%>"
        class="card-form-img"
        alt="<%= card.name %>"
      />
      <form action="/" method="POST">
        <input type="hidden" name="image" value="<%= card.image %>" />

        <div class="input-group" id="name-input">
          <label for="card-name">
            Name <img src="/images/non-edit.svg" class="helper-img" alt="" />
          </label>
          <input
            name="cardName"
            id="card-name"
            value="<%= card.name %>"
            readonly
            required
          />
        </div>

        <div class="input-group">
          <label for="card-game"
            >Game <img src="/images/non-edit.svg" class="helper-img"
          /></label>
          <input
            name="cardGame"
            id="card-game"
            value="<%= card.game %>"
            readonly
            required
          />
        </div>

        <div class="input-group" id="condition-input">
          <label for="condition">Condition</label>
          <select name="condition" id="condition" required>
            <option value="" disabled selected hidden></option>
            <option value="Mint">Mint</option>
            <option value="Near Mint">Near Mint</option>
            <option value="Lightly Played">Lightly Played</option>
            <option value="Moderately Played">Moderately Played</option>
            <option value="Heavily Played">Heavily Played</option>
            <option value="Damaged">Damaged</option>
          </select>
        </div>

        <div class="input-group" id="foil-input">
          <label for="is-foil">Foil</label>
          <input type="checkbox" name="isFoil" id="is-foil" />
        </div>

        <div
          class="input-group"
          id="quantity-input"
          aria-label="Quantity Controls"
        >
          <label for="quantity">Quantity</label>
          <div class="increment">
            <button
              type="button"
              class="increment-btn"
              id="decrease"
              aria-label="Decrease card quantity"
            >
              -
            </button>
            <input
              type="number"
              name="quantity"
              id="quantity"
              value="0"
              required
            />
            <button
              type="button"
              class="increment-btn"
              id="increase"
              aria-label="Increase card quantity"
            >
              +
            </button>
          </div>
        </div>

        <button type="submit" aria-label="Add new card to inventory">
          Submit
        </button>
      </form>
    </section>
  </body>
</html>
<script src="/utils/quantity.js"></script>
