<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/root.css" />
    <link rel="stylesheet" href="/styles/search.css" />
    <link rel="stylesheet" href="/styles/cardResults.css" />
    <title>Card Shop Inventory</title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <section id="inventory">
      <h1>Inventory</h1>
      <form action="/" method="GET" class="single search-bar">
        <button type="submit">
          <img src="/images/search.svg" />
        </button>
        <input
          type="text"
          name="searchName"
          placeholder="Search Card Here..."
          required
        />
      </form>
      <%- include("partials/inventoryCards") %>
    </section>
  </body>
</html>
