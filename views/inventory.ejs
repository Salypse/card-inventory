<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card Shop Inventory</title>
</head>
<body>
    <%- include("partials/navbar") %>
    <h1>Inventory</h1>
    <section>
        <strong>Search for a card in the inventory.</strong>
        <form  action="/inventory/search" method="GET">
            <label for="cardName">Name</label>
            <input type="text" name="cardName" id="card-name" required>

            <button type="submit">Search</button>
        </form>
    </section>
    <% if (locals.cards) {%>
        <%- include("partials/inventorySearchResults") %>
    <% } %>
</body>
</html>