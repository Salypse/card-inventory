<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/root.css" />
    <link rel="stylesheet" href="/styles/inventory.css" />
    <link rel="stylesheet" href="/styles/search.css" />
    <link rel="stylesheet" href="/styles/cardResults.css" />
    <link rel="stylesheet" href="/styles/filter.css" />
    <link rel="stylesheet" href="/styles/passwordCheck.css">
    <title>Card Shop Inventory</title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <section id="inventory">
      <div id="search-bar">
        <h1>Inventory</h1>
        <form
          action="/"
          method="GET"
          class="single search-bar"
          id="inventory-search"
        >
          <button type="submit" aria-label="Search inventory">
            <img src="/images/search.svg" alt="" />
          </button>
          <input
            type="text"
            name="searchName"
            placeholder="Search Card Here..."
            required
          />
        </form>
      </div>
      <% if (locals.error && error.type === "password") { %>
        <div class="helper-text">
          <h2>Incorrect Password.</h2>
          <p><%= error.text %></p>
        </div>
      <% }%>
      <%- include("partials/filter.ejs") %>
      <%-include("partials/inventoryCards") %>
    </section>
  </body>
</html>
<script src="/utils/filter.js"></script>
