<section id = "card-data-table">
  <% if (locals.error) { %>
    <h2>Error</h2>
    <p>Something went wrong while searching. Please try again.</p>

  <% } else if (locals.cards && locals.cards.length >= 1) { %>
    <h2>Search Results</h2>

    <table id="search-results">
      <tr>
        <th>Card Preview</th>
        <th>Name</th>
        <th>Set</th>
        <th>Type</th>
        <th>Element(s)</th>
        <th>Rarity</th>
        <th>Number</th>
        <th>Add</th>
      </tr>
      <% cards.forEach(card => { %>
        <tr>
          <td><img src=<%= card.image %>></td>
          <td><%= card.name %></td>
          <td><%= card.set %></td>
          <td><%= card.type %></td>
          <td><%= card.element %></td>
          <td><%= card.rarity %></td>
          <td><%= card.num %></td>
          <td>
            <form action="/add/form" method="POST">
              <input type="hidden" name="name" value="<%= card.name %>">
              <input type="hidden" name="game" value="<%= card.game %>">
              <input type="hidden" name="image" value="<%= card.image %>">
              <button type="submit">Add To Inventory</button>
            </form>>
          </td>
        </tr>
      <% }) %>
    </table>
  <% } else if (locals.cards && locals.cards.length <= 0) { %>
    <h2>No Results</h2>
    <p>No cards matched your search. Try checking spelling or using a different name.</p>
  <% } %>
</section>
