<aside id="filter">
    <button type="button" id="toggle-filter-off">
        <img src="/images/filter-icon-close.svg" class="toggle-img">
    </button>
    <form action="/" method="GET">
        <input type="hidden" name="searchName" value="<%- filter.searchName %>">

        <fieldset>
            <legend>Game</legend>
            
            <label>
                <input type="radio" name="game" value="" <%= !filter.game ? "checked" : "" %>> 
                All Games
            </label>

            <% inputFields.games.forEach((game) => { %>
                <label>
                    <input type="radio" name="game" value="<%= game %>" <%= filter.game === game ? "checked" : ""%>>
                    <%= (game) %>
                </label>
            <% }) %>
        </fieldset>

        <fieldset>
            <legend>Condition</legend>

            <label>
                <input type="radio" name="condition" value="" <%= !filter.condition ? "checked" : "" %>>
                All Conditions
            </label>

            <% inputFields.conditions.forEach((condition) => { %>
                <label>
                    <input type="radio" name="condition" value="<%= condition %>" <%= filter.condition === condition ? "checked" : ""%>>
                    <%= condition %>
                </label>
            <% }) %>
        </fieldset>

        <fieldset>
            <legend>Sort By</legend>

            <label>
                <input type="radio" name="sort" value="" <%= !filter.sort ? "checked" : "" %>>
                Default
            </label>

            <% inputFields.sortOptions.forEach((option) => { %>
                <label>
                    <input 
                        type="radio" 
                        name="sort" 
                        value="<%= option.value %>"
                        <%= filter.sort === option.value ? "checked" : "" %>
                    > 
                    <%= option.text %>
                </label>
            <% }) %>
        </fieldset>

        <label>
            <input type="checkbox" name="foil" <%= filter.foil === "on" ? "checked" : "" %>>
            Only Foils
        </label>

        <div id="filter-btns">
            <button type="submit">Apply Filter</button>
                <button type="button"><a href="/" tabindex="1">Clear Filter</a></button>
        </div>
    </form>
    
</aside>