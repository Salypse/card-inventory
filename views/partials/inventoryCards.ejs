<section>
    <% if (locals.cards.length >= 1) { %>
        <h2>Cards</h2>
        <%- include("../partials/filter") %>

        <table id="iventory-search-results">
            <tr>
                <th>Card Preview</th>
                <th>Name</th>
                <th>Game</th>
                <th>Condition</th>
                <th>Foil</th>
                <th>Quantity</th>
                <th>Options</th>
            </tr>
            <% cards.forEach(card => { %>
                <tr>
                    <td><img src=<%= card.image %>></td>
                    <td><%= card.name %></td>
                    <td><%= card.game %></td>
                    <td><%= card.condition %></td>
                    <td><%= card.is_foil === true ? "Yes" : "No" %></td>
                    <td><%= card.quantity %></td>
                    <td>
                        <form action="/<%= card.id %>/edit" method="GET">
                            <button type="submit">Edit</button>
                        </form>
                        <form action="/<%= card.id %>/delete" method="GET">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </table>
    <% } else {%>
        <strong>No Cards Found</strong>
    <% } %>
    <div>
        <strong>Can't find your card?</strong>
        <a href="/add">Add New Card to Inventory</a>
    </div>
</section>