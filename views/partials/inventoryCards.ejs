<section id="inventory-cards">
    <button type="button" id="toggle-filter-on">
        <img src="/images/filter-icon-open.svg" class="toggle-img">
    </button>
    <% if (locals.cards.length >= 1) { %>
        <h2>Cards</h2>

        <section id="card-results">
            <% cards.forEach(card => {  %>
                <div class="card">
                    <img src="<%= card.image %>">
                    
                    <div class="card-content">
                        <div class="card-details">
                            <strong class="card-name"><%= card.name%></strong>
                            <p><strong>Condition: </strong><%= card.condition %></p>
                            <p><strong>Foli: </strong><%= card.is_foil ? "Yes" : "No" %></p>
                            <p><strong>Quantity: </strong><%= card.quantity %></p>
                        </div>
                    
                        <div class="card-options">
                            <form action="/<%= card.id %>/edit" method="GET">
                                <button type="submit">Edit</button>
                            </form>
                            <form action="/<%= card.id %>/delete" method="GET">
                                <button type="submit">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
            </section>
    <% } else {%>
        <div class="helper-text">
            <strong>No Cards Found</strong>
        </div>
    <% } %>
    <div class="helper-text">
        <strong>Can't find your card?</strong>
        <a href="/add">Add New Card to Inventory</a>
    </div>
</section>