<section id="inventory-cards">
    <button type="button" id="toggle-filter-on" class="toggle-btn" aria-label="open filter">
        <img src="/images/filter-icon-open.svg" class="toggle-img">
    </button>
    <% if (locals.cards.length >= 1) { %>
        <h2>Cards</h2>

        <section id="card-results">
            <% cards.forEach(card => {  %>
                <article class="card">
                    <img src="<%= card.image %>" alt="<%= card.name %>">
                    
                    <div class="card-content">
                        <div class="card-details">
                            <h3 class="card-name"><%= card.name%></h3>
                            <p><strong>Condition: </strong><%= card.condition %></p>
                            <p><strong>Foil: </strong><%= card.is_foil ? "Yes" : "No" %></p>
                            <p><strong>Quantity: </strong><%= card.quantity %></p>
                        </div>
                    
                        <div class="card-options">
                            <form action="/<%= card.id %>/edit" method="GET">
                                <button type="submit" aria-label="Edit <%= card.name %> Card">Edit</button>
                            </form>
                            <form>
                                <button 
                                    onclick="openPasswordCheck(`Delete`, `<%= card.id %>`, `<%= card.name %>`)" 
                                    type="button" 
                                    aria-label="Delete <%= card.name %> Card">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            <% }) %>
            </section>
    <% } else {%>
        <div class="helper-text">
            <strong>No Cards Found</strong>
        </div>
    <% } %>
    <div class="helper-text">
        <strong>Can't find your card?</strong>
        <a href="/add">Add New Card to Inventory</a>
    </div>
</section>

 <%-include("../partials/passwordCheck.ejs") %>