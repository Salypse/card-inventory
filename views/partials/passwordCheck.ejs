<div style="display: none" id="password-check">
  <div id="password-container">
    <h2 id="password-title"></h2>

    <form id="password-form" method="POST">
      <input type="text" name="password" placeholder="Enter Password" />
      <button type="submit">Submit</button>
    </form>
    <button id="password-close" type="button" aria-label="close password check">
      Cancel
    </button>
  </div>

  <p id="password-error" style="display: none">Incorrect Password.</p>
</div>
<script src="/utils/passwordCheck.js"></script>
